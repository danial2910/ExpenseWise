# --- Database (this phase requires only these) ---
DB_URL=jdbc:postgresql://localhost:5433/expensewise
DB_USER=dev
DB_PASSWORD=devpass

# --- Auth (not this phase, scaffolded for later) ---
JWT_SECRET=
JWT_EXPIRATION=

# --- Supabase Storage (not this phase) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# --- AI / Groq (not this phase) ---
GROQ_API_KEY=
GROQ_MODEL=

# --- Email / Brevo (not this phase) ---
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
MAIL_FROM=

# NOTE (prod only): DB_URL for Supabase must use the Supavisor pooler on port
# 6543 and include ?prepareThreshold=0 in the URL, e.g.:
# jdbc:postgresql://<project>.pooler.supabase.com:6543/postgres?prepareThreshold=0
