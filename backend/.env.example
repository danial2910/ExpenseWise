# All variable names carry an _EXPENSEWISE suffix so they don't collide
# with identically-named env vars from other projects on a shared dev
# machine (this repo's convention — see DECISIONS.md). Set the real values
# via `setx NAME value` (Windows) or your shell profile; this file only
# documents the names, with empty/placeholder values.

# --- Database (this phase requires only these) ---
DB_URL_EXPENSEWISE=jdbc:postgresql://localhost:5433/expensewise
DB_USER_EXPENSEWISE=dev
DB_PASSWORD_EXPENSEWISE=devpass

# --- Auth ---
JWT_SECRET_EXPENSEWISE=
JWT_EXPIRATION_EXPENSEWISE=1800
REFRESH_TOKEN_EXPIRATION_EXPENSEWISE=604800
FRONTEND_URL_EXPENSEWISE=http://localhost:5173

# --- Supabase Storage (Profile module's avatar upload; StorageService is
# @MockBean'd in every test, so these are never actually called except in
# real local/prod use) ---
SUPABASE_URL_EXPENSEWISE=
SUPABASE_SERVICE_KEY_EXPENSEWISE=
SUPABASE_BUCKET_EXPENSEWISE=

# --- AI / Groq (no default — leave unset and the app still starts, but any
# real chat call fails with AI_UNAVAILABLE until a real key is set) ---
GROQ_API_KEY_EXPENSEWISE=
GROQ_MODEL_EXPENSEWISE=llama-3.3-70b-versatile

# --- Email / Brevo (HTTP API, not SMTP — leave BREVO_API_KEY_EXPENSEWISE
# blank locally to log reset links to the console instead) ---
BREVO_API_KEY_EXPENSEWISE=
MAIL_FROM_EXPENSEWISE=

# --- News / NewsData.io (no default — leave unset and the app still
# starts, but any real fetch fails with NEWS_UNAVAILABLE until a real key
# is set; NewsClient is @MockBean'd in every test) ---
NEWSDATA_API_KEY_EXPENSEWISE=

# NOTE (prod only): DB_URL_EXPENSEWISE for Supabase must use the Supavisor
# pooler on port 6543 and include ?prepareThreshold=0 in the URL, e.g.:
# jdbc:postgresql://<project>.pooler.supabase.com:6543/postgres?prepareThreshold=0
